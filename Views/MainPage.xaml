<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Vehicle_Maintenance_App.Views.MainPage"
             Title="Vehicle Maintenance App">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Welcome"
            FontSize="20"
            HorizontalOptions="Center"/>

        <Picker x:Name="VehiclePicker"
            Title="Select a Vehicle"
            ItemsSource="{Binding Vehicles}"
            SelectedItem="{Binding SelectedVehicle}"
            ItemDisplayBinding="{Binding Name}"
            SelectedIndexChanged="VehiclePicker_Change"
            WidthRequest="250"
            HorizontalOptions="Center"/>

        <VerticalStackLayout x:Name="MainButtonStack" Spacing="10" IsVisible="{Binding ButtonStackVisible}">
            <Button Text="Add Maintenance Event"
                Clicked="AddMaintenanceEvent_Click"/>
            <Button Text="View Maintenance Report"
                Clicked ="ViewMaintenanceReport_Click"/>
            <Button Text="Enter Maintenance Schedule"
                Clicked="EnterMaintenanceSchedule_Click"/>
            <Button Text="Edit Vehicle"
                Clicked="EditVehicle_Click"/>
        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentPage>
